<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:clipToPadding="true"
    android:fillViewport="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="28dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/hero_start"
            app:cardCornerRadius="24dp"
            app:cardElevation="10dp"
            app:strokeColor="@color/hero_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/hero_background"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.14"
                        android:text="@string/eyebrow"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/chip_background"
                        android:letterSpacing="0.06"
                        android:paddingStart="11dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="11dp"
                        android:paddingBottom="7dp"
                        android:text="@string/board_name"
                        android:textColor="@color/primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:letterSpacing="0.02"
                    android:text="@string/title"
                    android:textColor="@color/ink"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/subtitle"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/status_panel_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <View
                        android:id="@+id/root_indicator"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/status_dot" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/root_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/root_checking"
                            android:textColor="@color/ink"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/status_detail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/root_hint"
                            android:textColor="@color/muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/root_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:text="@string/badge_checking"
                        android:textColor="@color/success"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/interface_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/tab_background"
            android:padding="4dp"
            app:tabIndicator="@drawable/tab_indicator"
            app:tabIndicatorFullWidth="true"
            app:tabMode="scrollable"
            app:tabRippleColor="@color/tab_ripple"
            app:tabSelectedTextColor="@color/ink"
            app:tabTextColor="@color/muted" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/gpio_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.02"
                    android:text="@string/gpio_title"
                    android:textColor="@color/ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/gpio_help"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:letterSpacing="0.09"
                    android:text="@string/pin_label"
                    android:textColor="@color/primary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/gpio_pin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/input_background"
                    android:hint="@string/gpio_pin_hint"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:text="13"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/muted"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/gpio_read"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:text="@string/read_level"
                        android:textAllCaps="false"
                        android:textColor="@color/primary"
                        app:strokeColor="@color/line" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/gpio_release"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:text="@string/release_pin"
                        android:textAllCaps="false"
                        android:textColor="@color/muted"
                        app:strokeColor="@color/line" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/gpio_low"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:text="@string/hold_low"
                        android:textAllCaps="false"
                        android:textColor="@color/ink"
                        app:backgroundTint="@color/button_neutral"
                        app:cornerRadius="16dp"
                        app:elevation="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/gpio_high"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:text="@string/hold_high"
                        android:textAllCaps="false"
                        android:textColor="@color/deep"
                        app:backgroundTint="@color/button_primary"
                        app:cornerRadius="16dp"
                        app:elevation="5dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.08"
                        android:text="@string/bulk_gpio_title"
                        android:textColor="@color/ink"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bulk_gpio_count"
                        android:textColor="@color/muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/gpio_all_down"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:text="@string/all_down"
                        android:textAllCaps="false"
                        android:textColor="@color/ink"
                        app:backgroundTint="@color/button_down"
                        app:cornerRadius="16dp"
                        app:elevation="5dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/gpio_all_up"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:text="@string/all_up"
                        android:textAllCaps="false"
                        android:textColor="@color/deep"
                        app:backgroundTint="@color/button_up"
                        app:cornerRadius="16dp"
                        app:elevation="6dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/gpio_release_all"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/release_all_gpio"
                    android:textAllCaps="false"
                    android:textColor="@color/muted"
                    app:strokeColor="@color/line" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/warning_background"
                    android:padding="12dp"
                    android:text="@string/gpio_warning"
                    android:textColor="@color/warning"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/i2c_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/i2c_title"
                    android:textColor="@color/ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/i2c_help"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/i2c_sensor_read"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/i2c_sensor_read"
                    android:textAllCaps="false"
                    android:textColor="@color/deep"
                    app:backgroundTint="@color/button_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/uart_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/uart_title"
                    android:textColor="@color/ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/uart_help"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/uart_device"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1.4"
                        android:background="@drawable/input_background"
                        android:hint="@string/device_node"
                        android:inputType="text"
                        android:paddingStart="12dp"
                        android:paddingEnd="10dp"
                        android:singleLine="true"
                        android:text="/dev/ttyS1"
                        android:textColor="@color/ink"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/uart_baud"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/input_background"
                        android:hint="@string/baud_rate"
                        android:inputType="number"
                        android:paddingStart="12dp"
                        android:paddingEnd="10dp"
                        android:singleLine="true"
                        android:text="115200"
                        android:textColor="@color/ink"
                        android:textSize="13sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/uart_message"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/input_background"
                    android:hint="@string/uart_message_hint"
                    android:inputType="text"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:text="M2 UART TEST"
                    android:textColor="@color/ink"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/uart_send"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:text="@string/uart_send_receive"
                        android:textAllCaps="false"
                        android:textColor="@color/deep"
                        app:backgroundTint="@color/button_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/uart_receive"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:text="@string/uart_receive_only"
                        android:textAllCaps="false"
                        android:textColor="@color/primary"
                        app:strokeColor="@color/line" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/warning_background"
                    android:padding="12dp"
                    android:text="@string/uart_warning"
                    android:textColor="@color/warning"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/gps_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/gps_title"
                    android:textColor="@color/ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/gps_help"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/gps_device"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1.4"
                        android:background="@drawable/input_background"
                        android:hint="@string/device_node"
                        android:inputType="text"
                        android:paddingStart="12dp"
                        android:paddingEnd="10dp"
                        android:singleLine="true"
                        android:text="/dev/ttyS1"
                        android:textColor="@color/ink"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/gps_baud"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/input_background"
                        android:hint="@string/baud_rate"
                        android:inputType="number"
                        android:paddingStart="12dp"
                        android:paddingEnd="10dp"
                        android:singleLine="true"
                        android:text="115200"
                        android:textColor="@color/ink"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/gps_start"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:text="@string/gps_start"
                        android:textAllCaps="false"
                        android:textColor="@color/deep"
                        app:backgroundTint="@color/button_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/gps_stop"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="@string/gps_stop"
                        android:textAllCaps="false"
                        android:textColor="@color/primary"
                        app:strokeColor="@color/line" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/status_panel_background"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/gps_fix_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/gps_idle"
                        android:textColor="@color/muted"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/gps_coordinates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="monospace"
                        android:text="@string/gps_no_position"
                        android:textColor="@color/ink"
                        android:textIsSelectable="true"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/gps_metrics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:fontFamily="monospace"
                        android:text="@string/gps_metrics_empty"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/gps_stream_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/gps_stream_waiting"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/gps_open_map"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:enabled="false"
                    android:text="@string/gps_open_map"
                    android:textAllCaps="false"
                    android:textColor="@color/primary"
                    app:strokeColor="@color/line" />

                <LinearLayout
                    android:id="@+id/gps_map_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="320dp"
                        android:background="@drawable/status_panel_background"
                        android:clipToOutline="true">

                        <WebView
                            android:id="@+id/gps_map_preview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/white" />

                        <TextView
                            android:id="@+id/gps_map_status"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/card"
                            android:gravity="center"
                            android:padding="20dp"
                            android:text="@string/gps_map_loading"
                            android:textColor="@color/muted"
                            android:textSize="14sp" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/gps_map_attribution"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/warning_background"
                    android:padding="12dp"
                    android:text="@string/gps_warning"
                    android:textColor="@color/warning"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/spi_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/spi_title"
                    android:textColor="@color/ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/spi_help"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/oled_text"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/input_background"
                    android:hint="@string/oled_text_hint"
                    android:inputType="text"
                    android:maxLength="21"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:singleLine="true"
                    android:text="M2 CONTROL"
                    android:textColor="@color/ink"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/oled_show"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="@string/oled_show"
                        android:textAllCaps="false"
                        android:textColor="@color/deep"
                        app:backgroundTint="@color/button_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/oled_demo"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="@string/oled_demo"
                        android:textAllCaps="false"
                        android:textColor="@color/primary"
                        app:strokeColor="@color/line" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/oled_clear"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/oled_clear"
                        android:textAllCaps="false"
                        android:textColor="@color/muted"
                        app:strokeColor="@color/line" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/result_card"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="17dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.1"
                        android:text="@string/result_title"
                        android:textColor="@color/primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/result_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/result_idle"
                        android:textColor="@color/muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/result_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="monospace"
                    android:minHeight="54dp"
                    android:text="@string/result_empty"
                    android:textColor="@color/ink"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:text="@string/footer"
            android:textColor="@color/muted"
            android:textSize="9sp" />
    </LinearLayout>
</ScrollView>
